#: includes/abilities/verification.php:258
msgid "A type name to expand (e.g. Post, User, Term, Pagination). Case-sensitive."
msgstr ""

#: includes/abilities/verification.php:262
msgid "Case-insensitive fragment matched against type and field names (e.g. \"acf\", \"meta\", \"pagination\")."
msgstr ""

#: includes/abilities/verification.php:267
msgid "Bypass the cached schema (use after activating a plugin that extends it)."
msgstr ""

#: includes/abilities/verification.php:277

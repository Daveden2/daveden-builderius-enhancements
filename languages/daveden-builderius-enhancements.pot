msgstr ""

#: includes/features.php:167
msgid "Pro-focused helpers for opening, reading and protecting the CSS code editor."
msgstr ""

#: includes/features.php:171
msgid "Class naming"
msgstr ""

#: includes/features.php:172
msgid "Naming support for cleaner selectors before CSS is written."
msgstr ""

#: includes/features.php:178
msgid "Saving and protection"
msgstr ""

#: includes/features.php:179
msgid "The safeguards and shortcuts that protect builder work and make saving clearer."
msgstr ""

#: includes/features.php:183
msgid "Guidance and previewing"
msgstr ""

#: includes/features.php:184
msgid "On-screen guidance plus a canvas helper for checking responsive behaviour."
msgstr ""

#: includes/features.php:202
msgid "Accessibility essentials"
msgstr ""

#: includes/features.php:203
msgid "Keyboard routes, screen-reader structure, visible focus and clearer controls across the builder."
msgstr ""

#: includes/features.php:207
msgid "Keyboard workflow"
msgstr ""

#: includes/features.php:208
msgid "Fast movement, element actions, command search, shortcuts and reliable saving without leaving the keyboard."
msgstr ""

#: includes/features.php:212
msgid "Visual polish"
msgstr ""

#: includes/features.php:213
msgid "A calmer theme, clearer hierarchy and more readable controls without changing editing behaviour."
msgstr ""

#: includes/features.php:217
msgid "Safer editing"
msgstr ""

#: includes/features.php:218
msgid "Undo, save-state feedback, conflict protection and guarded CSS workflows that reduce accidental loss."
msgstr ""

#: includes/features.php:222
msgid "Power editing"
msgstr ""

#: includes/features.php:223
msgid "Command-driven structure, HTML and class tools for experienced Builderius users. Includes experimental features."
msgstr ""

#: includes/features.php:269
msgid "Consistent builder typeface"
msgstr ""

#: includes/features.php:270
msgid "One consistent typeface and tidier labels across the builder."
msgstr ""

#: includes/features.php:271
msgid "Applies one consistent typeface across the builder and tidies field labels, group headings and panel shadows to match."
msgstr ""

#: includes/features.php:277
msgid "Clearer tab underlines"
msgstr ""

#: includes/features.php:278
msgid "Clear accent underlines on every tab in the builder."
msgstr ""

#: includes/features.php:279
msgid "Gives every tab in the builder a clear underline in the accent colour (panel tabs, document tabs, scope switchers and settings tabs), and widens the search field in the CSS vars tab."
msgstr ""

#: includes/features.php:285
msgid "Recognisable search boxes"
msgstr ""

#: includes/features.php:286
msgid "Adds the missing magnifying-glass icons to search fields."
msgstr ""

#: includes/features.php:287
msgid "Adds a magnifying-glass icon to the builder search fields that lack one (the Navigator filter and the CSS vars search) so each reads as a search box at a glance. The Inserter search keeps its own built-in icon."
msgstr ""

#: includes/features.php:293
msgid "Restyled buttons and inputs"
msgstr ""

#: includes/features.php:294
msgid "Restyles buttons, inputs and dropdowns with accessible contrast."
msgstr ""

#: includes/features.php:295
msgid "Restyles buttons, inputs, dropdowns, segmented radios and the element inserter with the plugin's colour palette, meeting WCAG AA contrast."
msgstr ""

#: includes/features.php:301
msgid "Focus visibility"
msgstr ""

#: includes/features.php:302
msgid "A visible focus ring on every control."
msgstr ""

#: includes/features.php:303
msgid "Shows a visible focus ring on every interactive control in the builder, as required by WCAG 2.4.7."
msgstr ""

#: includes/features.php:309
msgid "Larger Navigator rows"
msgstr ""

#: includes/features.php:310
msgid "Larger, easier-to-scan Navigator rows."
msgstr ""

#: includes/features.php:311
msgid "Makes Navigator rows larger and easier to scan, with clear hover and selected states. The decorative drag-handle strip is removed; dragging still works from the visible row without turning nested indentation into a drag target."
msgstr ""

#: includes/features.php:317
msgid "Theme switcher (light / dark / auto)"
msgstr ""

#: includes/features.php:318
msgid "Light, dark or follow-the-OS builder theme."
msgstr ""

#: includes/features.php:319
msgid "Adds a top-bar button that switches the builder between light and dark themes, or follows your operating system automatically."
msgstr ""

#: includes/features.php:326
msgid "Density toggle"
msgstr ""

#: includes/features.php:327
msgid "Comfortable or compact spacing, switched from the top bar."
msgstr ""

#: includes/features.php:328
msgid "Adds a top-bar button that switches panel and Navigator spacing between comfortable and compact."
msgstr ""

#: includes/features.php:335
msgid "Keyboard access to the top bar"
msgstr ""

#: includes/features.php:336
msgid "Screen-reader grouping and arrow keys for the top-bar controls."
msgstr ""

#: includes/features.php:337
msgid "Gives the top-bar control clusters proper grouping for screen readers and keyboard users: the breakpoint switcher becomes a radio group (announces which breakpoint is current, arrow keys move and select it, one Tab stop), and the canvas width and zoom fields are grouped and labelled."
msgstr ""

#: includes/features.php:343
msgid "Keyboard access to the bottom bar"
msgstr ""

#: includes/features.php:344
msgid "Makes the bottom tool bar one Tab stop with arrow keys."
msgstr ""

#: includes/features.php:345
msgid "Wires the bottom bar of editor tools (Custom CSS, JavaScript, Dynamic Data, Sense AI and so on) as a keyboard toolbar: one Tab stop with arrow-key navigation, each available tool announces whether its panel is open, the shared panel is a labelled group, and unavailable tools are identified as coming soon without entering the keyboard sequence. Also wires the Global / Template scope tabs inside the JavaScript and Dynamic Data tools as a vertical tab list."
msgstr ""

#: includes/features.php:352
msgid "Accessible select comboboxes"
msgstr ""

#: includes/features.php:353
msgid "Keyboard and screen-reader support for the custom selects."
msgstr ""

#: includes/features.php:354
msgid "Makes the builder's custom select popovers (the preview picker, the responsive-strategy select, the element HTML-tag select and others) usable with a screen reader and the keyboard: proper combobox / listbox / option roles, one Tab stop, and arrow keys to move through the options with Enter to choose. Purely additive — typing to filter and clicking to choose are left to Builderius."
msgstr ""

#: includes/features.php:360
msgid "Accessible AI session tabs"
msgstr ""

#: includes/features.php:361
msgid "Proper tabs and keyboard access for the Sense AI sessions."
msgstr ""

#: includes/features.php:362
msgid "Wires the Sense AI terminal session tabs (Claude Code, Gemini CLI and so on) as a proper tab list for screen readers and the keyboard: the tabs announce which session is active, arrow keys move between them and switch with one Tab stop, the terminal below is exposed as their tab panel, and the \"new session\" button gets a clear name in place of its bare plus sign, plus a proper pop-up menu (arrow keys to choose an agent, Escape to close). In reachable remote terminals, Ctrl+` moves focus back to the active session tab so xterm cannot trap keyboard users. Purely additive: clicking to switch is left to Builderius."
msgstr ""

#: includes/features.php:368
msgid "Accessible builder tabs"
msgstr ""

#: includes/features.php:369
msgid "Arrow-key tab strips in the canvas, settings panel and Navigator."
msgstr ""

#: includes/features.php:370
msgid "Wires the builder's tab strips as proper tab lists for screen readers and the keyboard: the persistent template/component tabs above the canvas, the settings panel's Content / Styles tabs and the Navigator's Elements / Selectors / CSS vars tabs. Each tab announces whether it is current and each strip becomes one Tab stop where Left/Right, Home and End move between tabs; Enter or Space switches to the focused tab. Delete closes a focused canvas tab through Builderius's native close action, and the new-template button receives an accessible name."
msgstr ""

#: includes/features.php:376
msgid "Accessible settings groups"
msgstr ""

#: includes/features.php:377
msgid "Keyboard and screen-reader access for the settings-panel groups."
msgstr ""

#: includes/features.php:378
msgid "Makes the element settings panel's collapsible groups (Primary, Advanced, Attributes and so on) usable from the keyboard and a screen reader. Each group heading becomes a real Tab stop that announces itself as a button and whether its group is open, and Enter or Space opens and closes it. Without this the headings cannot take keyboard focus at all, so the settings inside a collapsed group are unreachable without a mouse."
msgstr ""

#: includes/features.php:384
msgid "Screen-reader landmarks"
msgstr ""

#: includes/features.php:385
msgid "Named landmark regions for each part of the builder."
msgstr ""

#: includes/features.php:386
msgid "Marks each part of the builder as a named landmark region for screen readers: the top toolbar, the element library / element settings panel, the canvas, the Navigator and the footer bar. It also names the canvas preview frame. You can then jump straight to a section from the screen reader's landmark list or with its region-jump keys, the way the WordPress block editor's regions work."
msgstr ""

#: includes/features.php:394
msgid "HTML tag badges"
msgstr ""

#: includes/features.php:395
msgid "Shows each element's HTML tag in the Navigator."
msgstr ""

#: includes/features.php:396
msgid "Shows each element's HTML tag (such as <section>) next to its label in the Navigator, in place of its first CSS class."
msgstr ""

#: includes/features.php:402
msgid "Tidier Navigator icons"
msgstr ""

#: includes/features.php:403
msgid "Hides repeated Navigator icons, keeping the meaningful ones."
msgstr ""

#: includes/features.php:404
msgid "Hides the repeated element-type icons in the Navigator, keeping only the ones that carry meaning (Collections and Templates)."
msgstr ""

#: includes/features.php:410
msgid "Collapse & expand buttons"
msgstr ""

#: includes/features.php:411
msgid "One-click expand or collapse of the whole tree."
msgstr ""

#: includes/features.php:412
msgid "Adds two buttons to the Navigator header: one expands every row, the other collapses the tree down to its top-level sections."
msgstr ""

#: includes/features.php:419
msgid "Navigator search"
msgstr ""

#: includes/features.php:420
msgid "A filter box for the Navigator tree."
msgstr ""

#: includes/features.php:421
msgid "Adds a filter box above the tree that hides non-matching branches while keeping the ancestors of matching elements visible for context. A live count reports the results."
msgstr ""

#: includes/features.php:428
msgid "Keyboard-accessible favourite editing"
msgstr ""

#: includes/features.php:429
msgid "Adds arrow-key reordering to Builderius’s favourites editor."
msgstr ""

#: includes/features.php:430
msgid "Extends Builderius’s native Edit favourites mode with accessible names, move announcements and Up/Down arrow-key reordering. Pointer dragging and persistence remain under Builderius’s control. On older Builderius versions without the native editor, DBE supplies its original drag-and-keyboard fallback."
msgstr ""

#: includes/features.php:437
msgid "Follow selection in the tree"
msgstr ""

#: includes/features.php:438
msgid "The tree follows your selection; a path remains when it is hidden."
msgstr ""

#: includes/features.php:439
msgid "When you click an element in the preview, the Navigator opens the branches down to it and scrolls it into view. If the Navigator is hidden, a compact path above the canvas keeps the selected element in context."
msgstr ""

#: includes/features.php:445
msgid "Navigator keyboard tree"
msgstr ""

#: includes/features.php:446
msgid "Full arrow-key navigation of the tree, WordPress style."
msgstr ""

#: includes/features.php:447
msgid "Makes the Navigator behave like the WordPress list view: the arrow keys move through the elements (the canvas selection follows), the right arrow opens a branch and steps into it, the left arrow closes it and steps out to the parent, and Home and End jump to the first and last. The same keys navigate the canvas while it is in selection mode, including when the Navigator panel is hidden. The tree is exposed to screen readers as a proper tree, so each element announces its level, whether it is expanded, and its position."
msgstr ""

#: includes/features.php:453
msgid "Navigator row quick actions"
msgstr ""

#: includes/features.php:454
msgid "Duplicate and Delete buttons on the hovered or focused row."
msgstr ""

#: includes/features.php:455
msgid "Shows Duplicate and Delete buttons at the right edge of a Navigator row when you point at it or move keyboard focus onto it. From a focused row, Tab reaches the buttons and Escape returns to the row; after duplicating, focus lands on the copy, and after deleting it moves to a neighbouring row. Delete asks for a confirming second press, then offers Undo when Undo / redo element changes is on. Can also be set to sit permanently on the selected row."
msgstr ""

#: includes/features.php:462
msgid "Detachable Navigator"
msgstr ""

#: includes/features.php:463
msgid "Float the Navigator over the canvas."
msgstr ""

#: includes/features.php:464
msgid "Adds a detach button to the Navigator header so you can float the panel over the canvas. Drag it by its header, resize it from the bottom corner, and dock it again with the same button. Its position is remembered. It floats the panel over the builder chrome, so a Builderius update could shift it."
msgstr ""

#: includes/features.php:472
msgid "Preview right-click menu"
msgstr ""

#: includes/features.php:473
msgid "Use element actions directly from the preview canvas."
msgstr ""

#: includes/features.php:474
msgid "In canvas selection mode, right-click a rendered element to select it and open the same action menu used in the Navigator. Shift+F10 and the Menu key open it from the keyboard. Interaction mode, editable content, form controls and embedded documents retain their normal context menus."
msgstr ""

#: includes/features.php:482
msgid "Rename from the preview"
msgstr ""

#: includes/features.php:483
msgid "Change an element’s Navigator name without editing its visible text."
msgstr ""

#: includes/features.php:484
msgid "Adds a clear Navigator name dialog to the preview right-click menu and opens it with F2 while a rendered element has canvas focus. Save applies through Builderius’s existing rename channel; Cancel and Escape leave the name unchanged and return focus to the rendered element."
msgstr ""

#: includes/features.php:492
msgid "Right-click menu enhancements"
msgstr ""

#: includes/features.php:493
msgid "A flatter, keyboard-friendly right-click menu."
msgstr ""

#: includes/features.php:494
msgid "Reorganises the Navigator right-click menu around the actions used most often, with compact flyouts for inserting, moving and advanced tools. Includes full keyboard support (arrow keys, Home/End and Escape); unavailable commands remain discoverable and explain why they cannot currently run. Also adds a right-click copy and remove menu to the class chips in the Styles editor."
msgstr ""

#: includes/features.php:501
msgid "Wrap in… / Unwrap"
msgstr ""

#: includes/features.php:502
msgid "Wrap elements in a div, template or collection - and unwrap."
msgstr ""

#: includes/features.php:503
msgid "Right-click an element to wrap it in a div, a template or a collection with template. Unwrap does the reverse: it moves the children up one level and removes the empty wrapper."
msgstr ""

#: includes/features.php:510
msgid "Move & navigate elements"
msgstr ""

#: includes/features.php:511
msgid "Reorder, indent and outdent elements from the keyboard or menus."
msgstr ""

#: includes/features.php:512
msgid "Move an element among its siblings with Alt+Up/Down, move it into its previous sibling with Alt+Right, or move it out one level with Alt+Left while its Navigator row is focused. The same actions appear in the right-click menu and command palette, alongside Select parent for navigation."
msgstr ""

#: includes/features.php:518
msgid "Paste where you click"
msgstr ""

#: includes/features.php:519
msgid "Paste lands on the right-clicked row, or at top level from empty space."
msgstr ""

#: includes/features.php:520
msgid "Makes Paste in the Navigator right-click menu insert into the element you right-clicked, instead of whichever element happens to be selected, and adds a right-click menu to the empty space below the tree with Paste at top level. Either way, you can paste without selecting anything first."
msgstr ""

#: includes/features.php:527
msgid "Inline rename"
msgstr ""

#: includes/features.php:528
msgid "Rename an element directly on its Navigator row."
msgstr ""

#: includes/features.php:529
msgid "Lets you rename an element directly on its Navigator row from the right-click menu, or reset its label to the default (its HTML tag)."
msgstr ""

#: includes/features.php:537
msgid "Double-click to rename"
msgstr ""

#: includes/features.php:538
msgid "Double-click a row to rename it."
msgstr ""

#: includes/features.php:539
msgid "Double-click an element's Navigator row to rename it in place, without opening the right-click menu."
msgstr ""

#: includes/features.php:546
msgid "Undo / redo element changes"
msgstr ""

#: includes/features.php:547
msgid "Undo element structure and selected DBE property changes."
msgstr ""

#: includes/features.php:548
msgid "Undo adding, deleting or structurally moving an element, plus class, attribute and tag changes made through DBE, from the confirmation message or with Cmd/Ctrl+Z. A deleted element is restored to its previous sibling position, an added element is removed, and a reordered, indented or outdented element returns to its previous position. The message then offers Redo; Cmd/Ctrl+Shift+Z also redoes the change. Other settings changes are not covered."
msgstr ""

#: includes/features.php:566
msgid "Rearrange component properties"
msgstr ""

#: includes/features.php:567
msgid "Drag or arrow-key reordering of component properties."
msgstr ""

#: includes/features.php:568
msgid "Adds a rearrange button to a component's properties panel. Drag the properties, or use the arrow keys, to change their order; the new order is saved with the component."
msgstr ""

#: includes/features.php:574
msgid "HTML attribute helpers"
msgstr ""

#: includes/features.php:575
msgid "A ready-to-type attribute row plus common-name suggestions."
msgstr ""

#: includes/features.php:576
msgid "Opens a blank, ready-to-type row when an element has no HTML attributes yet (it is removed again if left empty), and suggests common attribute names such as id, role, aria-* and data-*."
msgstr ""

#: includes/features.php:582
msgid "Image placeholder & default alt"
msgstr ""

#: includes/features.php:583
msgid "New Image elements get a visible placeholder and an alt attribute."
msgstr ""

#: includes/features.php:584
msgid "Gives a newly inserted Image element a built-in placeholder graphic (an inline SVG, no file involved) so it is visible on the canvas straight away, and an empty alt attribute so the image is never missing one — empty alt marks it as decorative until you write the real text. Choosing an image from the media library replaces the placeholder, and the alt attribute is filled from the media library's alt text when one is set."
msgstr ""

#: includes/features.php:590
msgid "Display-condition helpers"
msgstr ""

#: includes/features.php:591
msgid "A ready blank condition, labelled fields, and cues where conditions exist."
msgstr ""

#: includes/features.php:592
msgid "Helps with an element's display conditions (the settings panel's conditions mode). Opens a blank, ready-to-choose condition when an element has none yet (it is removed again if you leave without touching it), gives every condition field a proper screen-reader label, makes the multi-value pickers keyboard-operable, and marks elements that carry conditions: a dot on the conditions button and on their Navigator rows, announced to screen readers."
msgstr ""

#: includes/features.php:598
msgid "Inserter keyboard navigation"
msgstr ""

#: includes/features.php:599
msgid "Arrow-key navigation of the element Inserter and favourites."
msgstr ""

#: includes/features.php:600
msgid "Makes the element Inserter navigable from the keyboard the way the WordPress block inserter is: each category is one Tab stop, the arrow keys move between its available elements, and Enter or Space inserts. Elements marked “Soon” are announced as coming soon and excluded from the keyboard sequence. The favourite-elements strip also becomes one vertical toolbar Tab stop with action-led names such as “Insert Heading”. Without this feature, reaching a lower category or later favourite means tabbing through every element above it."
msgstr ""

#: includes/features.php:606
msgid "Accessible Builderius menu"
msgstr ""

#: includes/features.php:607
msgid "Keyboard and screen-reader access for the Builderius menu."
msgstr ""

#: includes/features.php:608
msgid "Makes the Builderius menu (the sidebar of templates, pages, components and admin links) usable from the keyboard and a screen reader. The menu button announces that it opens the menu, focus moves into it when it opens, and it is exposed as a tree: the arrow keys move between the collapsible category headings and their items, the right and left arrows open and close a category, Enter or Space toggles a heading or opens an item, Home and End jump to the ends, and Escape (or the panel’s Close button) closes the menu and returns focus to the button."
msgstr ""

#: includes/features.php:614
msgid "Extended builder keyboard shortcuts"
msgstr ""

#: includes/features.php:615
msgid "Additional shortcuts for selected elements and builder regions."
msgstr ""

#: includes/features.php:616
msgid "Extends Builderius’s element shortcuts with add before or after, canvas text editing and direct routes to the Element library, Settings, Canvas, Navigator or Footer bar—even from a search field or code editor. On older Builderius versions, DBE also supplies Duplicate, Cut and Rename as compatibility fallbacks. The command palette and shortcut reference list the available DBE routes."
msgstr ""

#: includes/features.php:623
#: includes/i18n-builder.php:586
msgid "Edit as HTML"
msgstr ""

#: includes/features.php:624
msgid "Edit an element and its children as HTML markup."
msgstr ""

#: includes/features.php:625
msgid "Adds Edit as HTML to the right-click menu. Its code editor auto-closes non-void tags, validates tag structure, formats markup, renames matching tag pairs and suggests HTML tags, attributes, dynamic-data expressions, registered components and existing Builderius classes. A selected repeated pattern can become a Collection with static JSON, or an existing selected subtree can be handed to Builderius’s native component creator after Apply. Existing data-dbe-id markers preserve labels, conditions and other settings; components use <dbe-component>, while unsupported modules use <dbe-keep> and remain unchanged. A review step shows updated, added, removed and sanitised items before anything is applied, with a clear warning that the complete operation cannot be undone. Scripts, event handlers, dangerous URLs and unknown elements are removed. Experimental, and requires Builderius Pro."
msgstr ""

#: includes/features.php:633
msgid "Applying rewrites the whole element and everything inside it in one step, which cannot be undone. Review the preview before you apply, and save your work first."
msgstr ""

#: includes/features.php:636
#: includes/i18n-builder.php:677
msgid "Import HTML"
msgstr ""

#: includes/features.php:637
msgid "Paste HTML and turn it into real elements."
msgstr ""

#: includes/features.php:638
msgid "Adds Import HTML to the right-click menu: paste markup into a code editor that auto-closes non-void tags, validates tag structure, formats markup, renames matching tag pairs and suggests HTML tags, attributes, dynamic-data expressions, registered components and existing Builderius classes; then check the live preview and insert it into the chosen element (or after it, when that element cannot hold children). Several top-level elements are fine. Pasted <template> elements become Template modules, and an element carrying a data-b-context attribute (or data-dbe-module=\"collection\") becomes a Collection, so dynamic lists can be imported ready to bind. Add data-dbe-label=\"…\" to any element to name it in the Navigator. Script tags, event-handler attributes, javascript:, vbscript: and script-bearing data: URLs, and unknown elements are stripped before anything is created. The dialog warns that a complete import cannot be undone as one action. Experimental, and requires Builderius Pro."
msgstr ""

#: includes/features.php:646
msgid "A complete import cannot be undone as one action; the elements it creates have to be deleted afterwards. Check the preview before you insert, and save your work first."
msgstr ""

#: includes/features.php:649
msgid "Change HTML tag from the Navigator"
msgstr ""

#: includes/features.php:650
msgid "Swap an element's HTML tag from the right-click menu."
msgstr ""

#: includes/features.php:651
msgid "Adds a Change tag flyout to an element's right-click menu in the Navigator, so you can swap a div for a section, a p for an h2 and so on without opening the settings panel. If the element's label was just its tag, the label follows the new tag. Requires Builderius Pro."
msgstr ""

#: includes/features.php:660
#: includes/i18n-builder.php:491
#: includes/i18n-builder.php:583
msgid "Command palette"
msgstr ""

#: includes/features.php:661
msgid "A searchable command palette on Cmd/Ctrl+K, with a top-bar button."
msgstr ""

#: includes/features.php:662
msgid "Press Cmd/Ctrl+K (the shortcut is changeable below) or use the palette button in the top bar for a searchable command palette, including when focus is inside the preview canvas. Add classes, HTML attributes and child elements with minimal Emmet syntax (e.g. section.hero>h1{Title}+p{Lead}), run element and structure actions, persistently show or hide either side panel, jump between builder regions, and open key WordPress or Builderius admin pages in a new tab. Unavailable commands stay visible and explain what is needed; empty searches and invalid input receive inline guidance. Event-handler attributes and javascript: URLs are stripped."
msgstr ""

#: includes/features.php:671
msgid "CSS code editor by default"
msgstr ""

#: includes/features.php:672
msgid "Opens the Styles tab straight into the CSS code editor."
msgstr ""

#: includes/features.php:673
msgid "Opens the Styles tab straight into the CSS code editor and keeps the Content and Styles tabs visible while you are there. (To widen the panel for more room, use the Resizable side panels feature.) Requires Builderius Pro: the CSS code editor is a Pro feature, so this stays off (and the CSS-mode icon is left in place) when Pro is inactive."
msgstr ""

#: includes/features.php:681
msgid "CSS scope bar"
msgstr ""

#: includes/features.php:682
msgid "Shows and switches where CSS edits are saved."
msgstr ""

#: includes/features.php:683
msgid "Shows where your CSS edits will be saved (local, global or template) and adds an instant Global/Template switch, directly in the Styles code editor. Also keeps the editor honest: it shows only the active scope’s rules for the selected class, so global and template CSS never look merged, and it hides the other scope’s rules (with a one-click switch) instead of letting you fork them by mistake. Adds an “All CSS” button that jumps to the full stylesheet for the active scope (the same view as Selectors → All CSS) and highlights where the current selector’s rules sit within it. Requires Builderius Pro: global and template CSS scopes, and the code editor it sits in, are Pro features."
msgstr ""

#: includes/features.php:692
#: includes/i18n-builder.php:77
msgid "Auto-BEM"
msgstr ""

#: includes/features.php:693
msgid "Suggested BEM class names for an element and its children."
msgstr ""

#: includes/features.php:694
msgid "Right-click an element and choose Auto-BEM to get suggested block and element class names (such as hero, hero__title and hero__image) for it and everything inside it. Edit any suggestion, then apply them all in one go."
msgstr ""

#: includes/features.php:703
msgid "Hide the code minimap"
msgstr ""

#: includes/features.php:704
msgid "Removes the code editor's minimap strip."
msgstr ""

#: includes/features.php:705
msgid "Removes the minimap (the small code-overview strip on the right of the CSS code editor) and reclaims the width Monaco reserves for it, so long lines run to the edge of the panel. It switches the editor option off inside the builder's bundled Monaco; if a Builderius update ever changes that, it falls back to simply hiding the minimap from view."
msgstr ""

#: includes/features.php:711
msgid "Compact selector hint"
msgstr ""

#: includes/features.php:712
msgid "A compact, dismissible hint under the CSS editor."
msgstr ""

#. translators: %local% and %selector% are literal Builderius CSS scope tokens.
#: includes/features.php:714
#, php-format
msgid "Replaces Builderius’ two-line %local% / %selector% notification under the CSS editor with a compact, dismissible hint, reclaiming the vertical space for the editor. The full explanation moves into a dialog and is reworded so both tokens are described consistently and breakpoints are explained the same way for each (the stock wording differs between them)."
msgstr ""

#: includes/features.php:722
msgid "Tooltips & accessible names"
msgstr ""

#: includes/features.php:723
msgid "Tooltips and names for the unlabelled icon buttons."
msgstr ""

#: includes/features.php:724
msgid "Adds tooltips and accessible names to around 25 icon-only builder buttons that ship without either."
msgstr ""

#: includes/features.php:730
msgid "Keyboard shortcut reference"
msgstr ""

#: includes/features.php:731
msgid "Press ? to open the builder’s shortcut reference."
msgstr ""

#: includes/features.php:732
msgid "Press ? to open Builderius’s native Shortcuts panel with additional DBE groups for enabled plugin commands. On older Builderius versions without that panel, DBE supplies its own complete shortcut dialog."
msgstr ""

#: includes/features.php:738
msgid "Save status"
msgstr ""

#: includes/features.php:739
msgid "Clean, unsaved, saving, saved and failed status beside Save."
msgstr ""

#: includes/features.php:740
msgid "Shows when module or settings changes are unsaved, when a save is running and when it has succeeded. A failed save keeps the changes marked as unsaved and prompts you to try again."
msgstr ""

#: includes/features.php:748
msgid "Save with Cmd/Ctrl+S"
msgstr ""

#: includes/features.php:749
msgid "Cmd/Ctrl+S saves the template."
msgstr ""

#: includes/features.php:750
msgid "Saves the template with Cmd/Ctrl+S, the shortcut every editor trains into your fingers, instead of opening the browser’s save-page dialog. It works wherever you are in the builder, including the code editors, just like the WordPress block editor."
msgstr ""

#: includes/features.php:756
msgid "Keyboard access for the Save options menu"
msgstr ""

#: includes/features.php:757
msgid "Keyboard and screen-reader access to Save and Publish options."
msgstr ""

#: includes/features.php:758
msgid "Builderius draws the Save button’s dropdown trigger inside the Save button itself, where keyboard and screen-reader users cannot reach it. This adds a separate, named menu button beside Save, with arrow-key navigation, unavailable-state announcements and Escape focus return for the Save to Development / Publish to Live menu. The proper fix still belongs in Builderius (reported upstream), so this compatibility layer can be retired when Builderius provides an accessible split button."
msgstr ""

#: includes/features.php:765
msgid "Builder tab protection"
msgstr ""

#: includes/features.php:766
msgid "Warns before opening the same template in another builder tab."
msgstr ""

#: includes/features.php:767
msgid "Uses Builderius’s native applied-template admin-bar link when available, makes the complete menu keyboard-operable, identifies the current preview mode as selected and unavailable, and warns before Builderius opens the same template in another tab. Older Builderius versions retain DBE’s direct link."
msgstr ""

#: includes/features.php:773
msgid "Preview resize handles"
msgstr ""

#: includes/features.php:774
msgid "Drag handles to resize the preview canvas."
msgstr ""

#: includes/features.php:775
msgid "Adds drag handles to both edges of the preview so you can resize it around the centre, which is handy for container-query work. The width readout updates as you drag and the matching breakpoint lights up as you cross it; past your widest breakpoint you can keep dragging to preview any width up to the full canvas. Above your widest breakpoint the builder has no canvas size of its own, so the handle sizes the canvas itself, which a Builderius update could affect."
msgstr ""

#: includes/features.php:782
msgid "Compact workspace views"
msgstr ""

#: includes/features.php:783
msgid "Keeps one usable builder view on narrow screens."
msgstr ""

#: includes/features.php:784
msgid "Below 720 CSS pixels, replaces overlapping panels and a zero-width canvas with a compact Builder view selector. Element library, Element settings, Canvas and Navigator are presented one at a time; changing view is announced, keyboard focus follows the chosen view, and the wider workspace layout returns unchanged when space is available again."
msgstr ""

#: includes/features.php:791
msgid "Resizable side panels"
msgstr ""

#: includes/features.php:792
msgid "Drag to set the side panels' width."
msgstr ""

#: includes/features.php:793
msgid "Adds a drag handle to the inner edge of each side panel so you can set their width. The settings panel and the Navigator share one width, so resizing either resizes both. Your chosen width is remembered. Replaces the old one-shot \"widen settings panel\" button."
msgstr ""

#: includes/features.php:799
msgid "Readable canvas overlay labels"
msgstr ""

#: includes/features.php:800
msgid "Readable labels on the canvas hover and selection overlays."
msgstr ""

#: includes/features.php:801
msgid "Fixes the label colours on the preview's hover and selection overlays, so you can tell the two apart and the labels meet WCAG AA contrast."
msgstr ""


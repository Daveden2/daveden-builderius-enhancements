#: includes/features.php:143
msgid "Tools for working faster once the right element is in view."
msgstr ""

#: includes/features.php:149
msgid "Everyday element actions"
msgstr ""

#: includes/features.php:150
msgid "Frequent right-click and Navigator actions, kept near the top because they change day-to-day editing speed."
msgstr ""

